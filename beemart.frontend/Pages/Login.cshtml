@page
@model beemart.frontend.Pages.LoginModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>BeeMart - Login</title>
    <link rel="stylesheet" href="/css/site.css" />
</head>
<body>
    <div class="auth-wrapper">
        <div class="auth-card">
            <h2 class="auth-title">BeeMart Login</h2>

            <div id="alertMessage" class="alert-box alert-danger"></div>

            <form id="formLogin" action="javascript:void(0);">
                <div class="form-group">
                    <label for="username">Username</label>
                    <input type="text" id="username" class="form-control" autocomplete="off" required />
                </div>

                <div class="form-group">
                    <label for="password">Password</label>
                    <input type="password" id="password" class="form-control" required />
                </div>

                <div class="form-group">
                    <label for="role">Role</label>
                    <select id="role" class="form-control" required>
                        <option value="Cashier">Kasir</option>
                        <option value="Admin">Admin</option>
                    </select>
                </div>

                <button type="submit" class="btn-primary" id="btnLogin">Login</button>
            </form>

            <a href="/Register" class="auth-link">Belum punya akun? Register</a>
        </div>
    </div>

    <script src="/js/login.js"></script>
</body>
</html>